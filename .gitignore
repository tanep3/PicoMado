# == たねちゃん式: 安心・高速・全部入り .gitignore ==

# Python
__pycache__/
*.py[cod]
*.class
.venv/
venv/
ENV/
env/
.uv/

# Node.js
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Rust
/target/
/service/target/
/Cargo.lock
pkg/

# 共通
.vscode/
*.code-workspace
.idea/
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp

# 環境変数（※.env は ignore、env.exampleをコピーして使う）
.env

# PicoMado device-local firmware settings
/firmware/config.h
/firmware/build*/

# Per-device firmware secrets, board binding, and outputs
/firmware/devices/*/config.h
/firmware/devices/*/board-id.txt
/firmware/build/

# Private test/device settings and local runtime data
/firmware/**/config.h
/firmware/**/test_config.h
/.config/
.env.*
!.env.example

# Capture/build outputs and reproducible download caches
*.pcap
*.pcapng
*.uf2
*.elf
/experiments/**/cache/

# Root-gate receipts and local artifacts
/.gate/
